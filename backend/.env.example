# ==============================================================================
# BYAnltiX Backend - Environment Configuration Template
# Copy this file to .env and adjust variables for your deployment environment.
# ==============================================================================

# Application Environment Mode ('development' | 'production')
APP_ENV=production

# Allowed Cross-Origin Resource Sharing (CORS) Origins (comma-separated, no trailing slash)
# Include your Vercel deployment domain and local development origins
CORS_ORIGINS=https://your-frontend.vercel.app,http://localhost:5173,http://127.0.0.1:5173

# Server Listen Port (Render assigns PORT automatically in production)
PORT=8000
